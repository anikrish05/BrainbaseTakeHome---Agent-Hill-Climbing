# Copy to .env and never commit it. Only the OpenRouter key is required.
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Optional: only for MODEL_PROVIDER=openai (calling OpenAI directly). SDK tracing
# export to OpenAI is disabled, so OpenRouter users can leave this empty.
OPENAI_API_KEY=
# Agent model (OpenRouter IDs are provider/model). Must support tool calling.
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Platform-side models. Defaults on OpenRouter: Sonnet 5.5 generates evals and
# proposes improvements; Gemini 3 Flash judges rubric criteria (a different model
# family from the agent and improver).
GENERATOR_MODEL=
IMPROVER_MODEL=
JUDGE_MODEL=
# Leave empty so the learner may pick any tool-capable OpenRouter model (about 265).
# Set comma-separated OpenRouter IDs only to narrow the search.
CLIMB_MODELS=
# Verified working with OpenRouter on 2026-10-20; chat_completions is the fallback.
MODEL_TRANSPORT=responses
# Local isolated execution. Start Docker Desktop first.
SANDBOX_IMAGE=python:3.12-slim
# Worker pools: deployed/playground runs and evaluation runs never share slots.
RUN_CONCURRENCY=2
EVAL_CONCURRENCY=6
# Hill climbing: candidates proposed per batch. The finalist and the parent then
# rerun every validation case BATCH_CONFIRM_RUNS more times before promotion.
BATCH_CANDIDATES=2
BATCH_CONFIRM=1
BATCH_CONFIRM_RUNS=2
# Automatic trigger: new reviewed corrections needed, and cooldown between batches.
BATCH_THRESHOLD=3
BATCH_COOLDOWN_SECONDS=60
BATCH_TIMEOUT_SECONDS=2400
BATCH_MAX_RUNS=250
BATCH_MAX_COST_USD=5.00
